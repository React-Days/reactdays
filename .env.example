# ReactDays SDK configuration
# Copy to `.env` (or `.env.local`) and fill in your values.
# Generate an API key at /dashboard/orgs/<your-org>/settings?tab=developers

# Required. Your public-read API key (starts with rd_pk_)
REACTDAYS_API_KEY=rd_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required. Your org slug
REACTDAYS_ORG=acme

# Required. The project slug within the org
REACTDAYS_PROJECT=marketing-site

# Optional. Override the API base URL (defaults to https://api.reactdays.com/v1)
# REACTDAYS_BASE_URL=https://api.reactdays.com/v1

# Browser / client-side usage (e.g. Next.js App Router client components).
# Bundlers only inline vars with a public prefix, so mirror the values you
# want available in the browser. Only expose the API key client-side once your
# org's origin allowlist is configured in the dashboard.
# NEXT_PUBLIC_REACTDAYS_API_KEY=rd_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_REACTDAYS_ORG=acme
# NEXT_PUBLIC_REACTDAYS_PROJECT=marketing-site
